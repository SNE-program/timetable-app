{
  "name": "timetable-app",
  "description": "课表助手 —— 本地优先的大学课表与上课提醒（Android）",
  "private": true,
  "version": "1.8.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "clean": "node scripts/clean.mjs all",
    "build": "node scripts/clean.mjs dist && vite build && node scripts/latest-json.mjs",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "check:version": "node scripts/check-version.mjs",
    "sync:android": "npm run build && node scripts/clean.mjs android && cap sync android",
    "apk": "npm run sync:android && cd android && gradlew.bat assembleRelease",
    "open:android": "cap open android",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
