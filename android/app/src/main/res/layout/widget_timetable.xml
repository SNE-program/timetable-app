<?xml version="1.0" encoding="utf-8"?>
<!--
  宽的那个小组件：下一节课 + 接下来几节课。

  三行课程是**写死在布局里的**，代码只切换可见性与文字 —— 不用
  RemoteViews.addView。原因有两个：
    1. addView 在部分桌面实现上会被拒绝，一旦抛异常整次 onUpdate 就废掉，
       小组件会停在 initialLayout 上什么都不显示（4×2 全白就是这个原因）；
    2. addView 每次都要重新 inflate，比直接 setTextViewText 慢。

  注意每行的子控件 id 必须独立。用 <include> 复用会让三行共用同一批 id，
  RemoteViews 按 id 查找时永远只命中第一行，三行会显示同样的内容。

  v1.9.6 把行高与内边距收紧了一档（内边距 12→10、字号与行距各减一点）：
  按桌面给的 110dp 高度算，原来固定部分就占掉 80dp，只塞得下一行，
  后两行其实是被裁到组件外面的 —— 用户看到的是"只显示了一节课"。
  现在同样高度能踏实放下两行，第三行留给拉高之后的尺寸（见 WidgetSize）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="10dp">

    <TextView
        android:id="@+id/widget_term"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:ellipsize="end"
        android:textSize="9sp"
        android:textColor="#8A8F98"
        android:text="课表助手" />

    <LinearLayout
        android:id="@+id/widget_next_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="2dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_next_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="end"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#1D2129" />

            <TextView
                android:id="@+id/widget_next_where"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="end"
                android:textSize="10sp"
                android:textColor="#8A8F98" />
        </LinearLayout>

        <Chronometer
            android:id="@+id/widget_next_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#1677FF" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1A000000" />

    <LinearLayout
        android:id="@+id/widget_r1_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="1dp"
        android:paddingBottom="1dp">

        <TextView
            android:id="@+id/widget_r1_time"
            android:layout_width="38dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textSize="10sp"
            android:textColor="#1677FF"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_r1_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="11.5sp"
            android:textColor="#1D2129" />

        <TextView
            android:id="@+id/widget_r1_where"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:maxWidth="84dp"
            android:textSize="10sp"
            android:textColor="#8A8F98" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_r2_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="1dp"
        android:paddingBottom="1dp">

        <TextView
            android:id="@+id/widget_r2_time"
            android:layout_width="38dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textSize="10sp"
            android:textColor="#1677FF"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_r2_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="11.5sp"
            android:textColor="#1D2129" />

        <TextView
            android:id="@+id/widget_r2_where"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:maxWidth="84dp"
            android:textSize="10sp"
            android:textColor="#8A8F98" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_r3_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="1dp"
        android:paddingBottom="1dp">

        <TextView
            android:id="@+id/widget_r3_time"
            android:layout_width="38dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textSize="10sp"
            android:textColor="#1677FF"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_r3_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="11.5sp"
            android:textColor="#1D2129" />

        <TextView
            android:id="@+id/widget_r3_where"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:maxWidth="84dp"
            android:textSize="10sp"
            android:textColor="#8A8F98" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:textSize="10sp"
        android:textColor="#8A8F98"
        android:text="打开应用同步一次" />

    <TextView
        android:id="@+id/widget_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textSize="9sp"
        android:textColor="#8A8F98"
        android:visibility="gone" />
</LinearLayout>